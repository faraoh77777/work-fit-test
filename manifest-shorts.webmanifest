{
  "name": "AI FIT",
  "short_name": "AI FIT",
  "description": "내 캐릭터로 내게 맞는 옷을 고르는 핏 체크 앱",
  "lang": "ko",
  "start_url": "./shorts.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#141414",
  "theme_color": "#141414",
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./shorts.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "image",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "id": "./shorts.html",
  "categories": [
    "shopping",
    "lifestyle"
  ],
  "screenshots": [
    {
      "src": "assets/store/ss1_main.jpg",
      "sizes": "720x1280",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "내 체형에 맞는 사이즈를 한눈에"
    },
    {
      "src": "assets/store/ss4_ai.jpg",
      "sizes": "720x1280",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "AI로 옷 입은 모습 보기"
    },
    {
      "src": "assets/store/ss2_closet.jpg",
      "sizes": "720x1280",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "내 옷장에서 갈아입혀 비교"
    },
    {
      "src": "assets/store/ss3_add.jpg",
      "sizes": "720x1280",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "사이즈표 캡처만 올리면 자동 입력"
    }
  ]
}